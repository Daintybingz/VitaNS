[binaries]
c = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-gcc'
cpp = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-g++'
ar = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-ar'
strip = '/opt/devkitpro/devkitA64/bin/aarch64-none-elf-strip'
pkgconfig = '/usr/bin/pkg-config'

[built-in options]
c_args = ['-I/opt/devkitpro/libnx/include', '-D__SWITCH__', '-O2', '-ffunction-sections', '-fdata-sections', '-pthread']
cpp_args = ['-I/opt/devkitpro/libnx/include', '-D__SWITCH__', '-O2', '-ffunction-sections', '-fdata-sections', '-pthread']
c_link_args = ['-pthread']
cpp_link_args = ['-pthread']

[host_machine]
system = 'none'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'

[properties]
needs_exe_wrapper = true
# Force regular archives (not thin archives) for Switch compatibility
ARFLAGS = '--no-thin'


